# Konfiguration des USB-Stick-Simulators (auf dem Pi: /etc/usb-stick-simulator.env)
# Alle Werte optional; gezeigt sind die Standardwerte.

# Ablage (files/) und Stick-Images (images/)
#USBSTICK_DATA_DIR=/var/lib/usb-stick-simulator

# Nominelle Stick-Größe in MB. Das Image ist eine Sparse-Datei: auf der SD-Karte belegt
# es nur so viel, wie Dateien darin liegen. Während einer Übernahme existieren kurz
# altes und neues Image gleichzeitig (doppelter Platz für die Dateien).
#USBSTICK_IMAGE_SIZE_MB=4096

# Datenträgername (1–11 Zeichen, A–Z 0–9 _ - Leerzeichen)
#USBSTICK_LABEL=PHOTON

# configfs = echte Hardware (Pi Zero 2 W / Zero W), fake = Entwicklung/Test ohne USB
#USBSTICK_GADGET=configfs

# Stick schreibgeschützt anbieten. Bei false kann der Drucker zwar schreiben, aber
# alles Geschriebene geht bei der nächsten Übernahme verloren.
#USBSTICK_READONLY=true

# Automatische Übernahme so viele Sekunden nach der letzten Änderung; 0 = nur per Knopf
#USBSTICK_APPLY_DELAY=10

# So lange (Sekunden) darf der Drucker nichts gelesen haben, bevor der Stick getauscht wird.
# Muss länger sein als die längste Pause zwischen zwei Schichten (Belichtung + Hub).
#USBSTICK_IDLE_SECONDS=60

# Pause zwischen Abziehen und Anstecken (Sekunden)
#USBSTICK_REPLUG_PAUSE=1.5

# Web-Oberfläche
#USBSTICK_HOST=0.0.0.0
#USBSTICK_PORT=80

# Optionaler Passwortschutz (HTTP Basic, unverschlüsselt – nur im eigenen WLAN sinnvoll)
#USBSTICK_WEB_USER=
#USBSTICK_WEB_PASSWORD=

# USB-Kennung des simulierten Sticks (Standard: Linux Foundation Multifunction Composite Gadget)
#USBSTICK_USB_VENDOR_ID=0x1d6b
#USBSTICK_USB_PRODUCT_ID=0x0104
#USBSTICK_USB_MANUFACTURER=USB-Stick-Simulator
#USBSTICK_USB_PRODUCT=Virtual USB Stick
#USBSTICK_USB_SERIAL=0123456789AB

# debug | info | warning | error
#LOG_LEVEL=info
